    "htmx",
    "smalltalk"
  ],
  "license": "MIT",
  "devDependencies": {
    "eslint": "^10.1.0",
    "jsdom": "^29.0.1",
    "terser": "^5.46.1"
  },
  "engines": {
    "node": ">=24.15.0"
  }
}

{
  "name": "talkdom",
  "version": "0.4.0",
  "description": "Smalltalk-inspired message passing for the DOM",
  "main": "index.js",
  "jsdelivr": "dist/talkdom.min.js",
  "unpkg": "dist/talkdom.min.js",
  "files": [
    "index.js",
    "websocket.js",
    "dist/talkdom.min.js",
    "dist/talkdom.min.js.map",
    "dist/talkdom-ws.min.js",
    "dist/talkdom-ws.min.js.map"
  ],
  "scripts": {
    "build": "node scripts/build.cjs",
    "test": "node test-runner.js && node --test test/*.test.cjs",
